<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jahia.modules</groupId>
    <artifactId>jahia-modules</artifactId>
    <version>8.2.1.0</version>
    <relativePath />
  </parent>
  <groupId>org.jahia.community</groupId>
  <artifactId>heading-anchors</artifactId>
  <version>1.0.0</version>
  <packaging>bundle</packaging>
  <name>Heading Anchors</name>
  <description>Render filter that adds slug-based anchors (and an optional copy-permalink button) to page headings.</description>
  <scm>
    <connection>scm:git:git@github.com:Jahia/heading-anchors.git</connection>
    <developerConnection>scm:git:git@github.com:Jahia/heading-anchors.git</developerConnection>
    <url>https://github.com/Jahia/heading-anchors</url>
    <tag>1_0_0</tag>
  </scm>
  <properties>
    <jahia-module-type>module</jahia-module-type>
    <sonar.projectKey>org.jahia.community:heading-anchors</sonar.projectKey>
    <sonar.sources>pom.xml,src/main</sonar.sources>
    <sonar.tests>src/test</sonar.tests>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <!-- 5.x: the module is built in Java 11 for Jahia 8.2.1+, JUnit 6 requires Java 17 -->
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>jahia-public</id>
      <name>Jahia Public Repository</name>
      <url>https://devtools.jahia.com/nexus/content/groups/public</url>
    </repository>
  </repositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <autoVersionSubmodules>true</autoVersionSubmodules>
          <tagNameFormat>@{project.version}</tagNameFormat>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <_dsannotations>org.jahia.community.headinganchors.*</_dsannotations>
            <_metatypeannotations>org.jahia.community.headinganchors.*</_metatypeannotations>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
